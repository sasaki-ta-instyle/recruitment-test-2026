# SQLite。Prisma は schema.prisma のあるディレクトリ起点で相対パスを解決するため、
# ローカル開発では prisma/ 配下に置きたい場合 "file:./dev.db" と書く（→ prisma/dev.db を指す）。
# 本番は ConoHa の /var/www/app/recruitment-test-2026/shared/db.sqlite を絶対パスで指す。
DATABASE_URL="file:./dev.db"
# Single password gate for /interviewer-guide and /admin.
# Username field at the browser prompt is ignored — only BASIC_AUTH_PASS is checked.
BASIC_AUTH_PASS="change-me-in-1password"
