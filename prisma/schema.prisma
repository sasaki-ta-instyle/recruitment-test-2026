// Prisma schema for recruitment-test-2026
// Stores Part1 (ipsative) answers and Part2 (essay) answers + computed scores.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Candidate {
  id            String        @id @default(cuid())
  name          String
  submittedAt   DateTime      @default(now())
  elapsedSec    Int           @default(0)
  // null=アクティブ。値があれば「アーカイブ済み」。削除は cascade で物理削除する。
  archivedAt    DateTime?
  // 面接官メモ（自由記述）。autosave で /admin/[id] から更新される。
  interviewerNotes String?
  part1Answers  Part1Answer[]
  part2Answers  Part2Answer[]
  score         Score?
  questionNotes QuestionNote[]
  invite        TestInvite?

  @@index([submittedAt])
  @@index([archivedAt])
}

model Part1Answer {
  id              String    @id @default(cuid())
  candidate       Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  candidateId     String
  questionIndex   Int
  // SQLite はスカラ配列をサポートしないため JSON 文字列で保存する。
  // 中身は ABCD 位置に並んだシャッフル後の極ラベル（例：["自責","他責","素直","素直じゃない"]）。
  shuffledPoles   String
  closestLetter   String?
  farthestLetter  String?
  // 確定スコアに反映された極（時間切れの場合 null）
  closestPole     String?
  farthestPole    String?

  @@unique([candidateId, questionIndex])
}

model Part2Answer {
  id            String    @id @default(cuid())
  candidate     Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  candidateId   String
  questionId    String
  bodyText      String
  charCount     Int       @default(0)
  elapsedSec    Int       @default(0)
  // 面接官が後から付ける Part2 採点（10/7/4/0 のいずれか）。未採点は null。
  score         Int?

  @@unique([candidateId, questionId])
}

model QuestionNote {
  id          String    @id @default(cuid())
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  candidateId String
  // 設問スコープ: "part1:0"〜"part1:19" / "part2:c1"〜"part2:c10"
  scope       String
  body        String
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())

  @@unique([candidateId, scope])
  @@index([candidateId])
}

// 受験者ごとに個別の URL とテスト時間窓を発行する。
// /test?t=<token> でアクセスし、その invite 固有の openAt〜closeAt の間だけ受験可能。
// 提出後に candidateId が紐づき、同じ URL は再利用不可になる。
model TestInvite {
  id          String     @id @default(cuid())
  token       String     @unique
  label       String     // 受験者識別用（氏名予定 / 案件名 etc.）
  openAt      DateTime?
  closeAt     DateTime?
  message     String?
  candidateId String?    @unique
  candidate   Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([token])
  @@index([createdAt])
}

// テスト受験時間の窓（シングルトン: id="singleton" の 1 行のみ運用）。
// openAt〜closeAt の間だけ受験者がテストを開始できる。closeAt 到達時は
// 進行中の回答も強制提出して終了する。null の場合は「常時閉鎖」とみなす。
model TestWindow {
  id        String    @id @default("singleton")
  openAt    DateTime?
  closeAt   DateTime?
  // 受験者ページに出すアナウンス（任意）
  message   String?
  updatedAt DateTime  @updatedAt
}

model Score {
  id             String    @id @default(cuid())
  candidate      Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  candidateId    String    @unique
  // 4 軸ネット（-20 〜 +20）：自他 / 素直 / 貢献 / ポジネガ
  axisSelf       Int
  axisSunao      Int
  axisContrib    Int
  axisPositive   Int
  bitKey         String    // "1110" など
  typeName       String
  verdict        String    // good-deep / good / develop / review / warn / ng
  matchStrength  String    // strong / clear / mid / weak / hold
  absoluteNg     Boolean   @default(false)
}
